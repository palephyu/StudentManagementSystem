@model StudentManagementSystem.ViewModels.Exam_VM

@{
    ViewData["Title"] = "စာမေးပွဲအသစ် ထည့်ရန်";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mt-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">ပင်မစာမျက်နှာ</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">စာမေးပွဲများ</a></li>
                    <li class="breadcrumb-item active">စာမေးပွဲအသစ်</li>
                </ol>
            </nav>

            <!-- Main Form -->
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-plus-circle"></i> စာမေးပွဲအသစ် ထည့်ရန်</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <!-- Exam Title -->
                            <div class="col-md-12 mb-3">
                                <label asp-for="ExamTitle" class="form-label fw-bold">
                                    <i class="fas fa-heading"></i> စာမေးပွဲခေါင်းစဉ် <span class="text-danger">*</span>
                                </label>
                                <input asp-for="ExamTitle" class="form-control" placeholder="ဥပမာ - အလယ်တန်းစာမေးပွဲ" />
                                <span asp-validation-for="ExamTitle" class="text-danger"></span>
                            </div>

                            <!-- Course and Class -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="CoursePkid" class="form-label fw-bold">
                                    <i class="fas fa-book"></i> သင်တန်း <span class="text-danger">*</span>
                                </label>
                                <select asp-for="CoursePkid" class="form-select" asp-items="ViewBag.CourseList">
                                    <option value="">-- သင်တန်းရွေးချယ်ပါ --</option>
                                </select>
                                <span asp-validation-for="CoursePkid" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ClassPkid" class="form-label fw-bold">
                                    <i class="fas fa-chalkboard"></i> အတန်း <span class="text-danger">*</span>
                                </label>
                                <select asp-for="ClassPkid" class="form-select" asp-items="ViewBag.ClassList">
                                    <option value="">-- အတန်းရွေးချယ်ပါ --</option>
                                </select>
                                <span asp-validation-for="ClassPkid" class="text-danger"></span>
                            </div>

                            <!-- Exam Date -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="ExamDate" class="form-label fw-bold">
                                    <i class="fas fa-calendar-day"></i> စာမေးပွဲရက်စွဲ <span class="text-danger">*</span>
                                </label>
                                <input asp-for="ExamDate" type="date" class="form-control" />
                                <span asp-validation-for="ExamDate" class="text-danger"></span>
                            </div>

                            <!-- Max Marks -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxMarks" class="form-label fw-bold">
                                    <i class="fas fa-star"></i> အမှတ်အများဆုံး <span class="text-danger">*</span>
                                </label>
                                <input asp-for="MaxMarks" type="number" class="form-control" />
                                <span asp-validation-for="MaxMarks" class="text-danger"></span>
                            </div>

                            <!-- Start and End Time -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartTime" class="form-label fw-bold">
                                    <i class="fas fa-hourglass-start"></i> စတင်ချိန်
                                </label>
                                <input asp-for="StartTime" type="time" class="form-control" />
                                <span asp-validation-for="StartTime" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="EndTime" class="form-label fw-bold">
                                    <i class="fas fa-hourglass-end"></i> ပြီးဆုံးချိန်
                                </label>
                                <input asp-for="EndTime" type="time" class="form-control" />
                                <span asp-validation-for="EndTime" class="text-danger"></span>
                            </div>

                            <!-- Location -->
                            <div class="col-md-12 mb-3">
                                <label asp-for="Location" class="form-label fw-bold">
                                    <i class="fas fa-map-marker-alt"></i> နေရာ
                                </label>
                                <input asp-for="Location" class="form-control" placeholder="ဥပမာ - ခန်းမ ၁၊ စာသင်ခန်း ၂၀၁" />
                                <span asp-validation-for="Location" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> သိမ်းဆည်းမည်
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> မသိမ်းတော့ပါ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}